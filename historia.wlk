import cazador.*
import caperucita.*
import feroz.*

object historia {
        method verFinalMalo(){
            feroz.correrAUnLugar()
            feroz.correrAUnLugar()
            feroz.comerAlgo(abuelita.peso())
            caperucita.seLeCaeUnaManzana()
            feroz.comerAlgo(caperucita.peso())
            feroz.veAlCazador()
        }

        method verFinalBueno(){
            feroz.correrAUnLugar()
            feroz.correrAUnLugar()
            feroz.comerAlgo(abuelita.peso())
            caperucita.seLeCaeUnaManzana()
            feroz.comerAlgo(caperucita.peso())
            feroz.veAlCazador()
            cazador.armarAlCazador()
            feroz.veAlCazador()
        }


    }